APP_ENV=development
DATABASE_URL=postgresql+psycopg2://localhost/nakupovalni_listek
# Required: generate locally with `openssl rand -hex 32`; never reuse it in production.
JWT_SECRET=
JWT_EXPIRY_MINUTES=60
AUTH_RATE_LIMIT_WINDOW_SECONDS=60
LOGIN_RATE_LIMIT=10
REGISTER_RATE_LIMIT=5
AUTH_RATE_LIMIT_MAX_KEYS=10000
# pydantic-settings parses complex values as JSON.
CORS_ORIGINS=["http://localhost:3000"]
